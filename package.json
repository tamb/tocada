{
  "name": "tocada",
  "version": "3.0.0",
  "description": "Pointer and touch gestures with ease! (Inspired by the wonderful Tocca.js library). Written in Typescript with love",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly --declaration --outDir ./dist && bun build.js",
    "build:pack": "bun run build && npm pack",
    "build:watch": "concurrently \"tsc --watch\" \"bun build.js --watch\"",
    "demo": "bun clean.ts && bun run test && bun run build && bun run demo:gh-pages",
    "demo:gh-pages": "cd gh-pages && bun install --clean && bun run dev:tunnel",
    "safe-publish": "bun run test && bun run build && npm publish",
    "serve": "bunx serve ./",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=coverage",
    "test:watch": "bunx test --watch"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/tamb/tocada.git"
  },
  "author": "Gianluca Guarini, Tamb",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tamb/tocada/issues"
  },
  "homepage": "https://github.com/tamb/tocada.js",
  "keywords": [
    "touch",
    "pointer",
    "pointer-events",
    "events",
    "mobile",
    "swipe",
    "gesture",
    "tap",
    "dbltap",
    "longtap",
    "swipeleft",
    "swiperight",
    "swipeup",
    "swipedown",
    "swipecancel",
    "velocity",
    "pinch",
    "spread",
    "typescript"
  ],
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.10",
    "concurrently": "^9.2.1",
    "typescript": "^7.0.2"
  }
}